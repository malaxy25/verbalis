<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Swift helper verbalis-audiotap (system audio via Core Audio process tap). audio-input in case the
  hardened runtime treats the tap's aggregate device as audio input; the TCC prompt itself is attributed
  to Verbalis.app (the responsible process) with its NSAudioCaptureUsageDescription.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>

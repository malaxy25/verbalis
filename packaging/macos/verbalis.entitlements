<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for Verbalis.app (main executable and verbalis-cli), see docs/CODE-SIGNING.md.
  Keep this list short: every entry weakens the hardened runtime a little.
  - audio-input: microphone (NSMicrophoneUsageDescription). Without it the hardened runtime blocks the mic
    even when the user allowed it.
  - allow-unsigned-executable-memory: libffi closures need writable+executable memory – soundcard's
    Core Audio callbacks (cffi), pywebview's Cocoa window (PyObjC), ctypes.
  - disable-library-validation: the optional Apple-GPU add-on (MLX) is unpacked into ~/.verbalis/mlx at
    runtime and is not signed by our team – library validation would refuse to load it.
  System audio (Core Audio process tap) and screen capture (snapshots) need no entitlement outside the
  App Sandbox – only the TCC permissions «Systemaudio» / «Bildschirmaufnahme» and, for the tap,
  NSAudioCaptureUsageDescription in Info.plist.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
